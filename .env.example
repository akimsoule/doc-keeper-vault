# Example environment file for production
# Copy this file to .env and update with your actual values

# PostgreSQL Database URL
# For local development with PostgreSQL:
DATABASE_URL="postgresql://username:password@localhost:5432/dockeeper_db?sslmode=prefer"

# For production (Render, Railway, Supabase, etc.):
# DATABASE_URL="postgresql://username:password@hostname:port/database_name?sslmode=require"

# JWT Secret - Generate a strong secret key
JWT_SECRET="generate-a-strong-secret-key-here"

# MEGA Storage credentials
MEGA_EMAIL="your-mega-email@example.com"
MEGA_PASSWORD="your-mega-password"

# Application environment
NODE_ENV="development"
