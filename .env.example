# Variables d'environnement pour Doc Keeper Vault

# Base de données PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/dockeeper?schema=public"

# JWT Secret - GÉNÉREZ UN SECRET FORT ET UNIQUE !
# Utilisez: ./generate-secrets.sh ou openssl rand -hex 64
JWT_SECRET="your_very_long_and_secure_jwt_secret_key_generated_with_openssl_rand_hex_64"

# Clé de chiffrement pour les mots de passe cloud storage (32 bytes minimum)
# Utilisez: ./generate-secrets.sh ou openssl rand -hex 32
CLOUD_ENCRYPTION_KEY="your_32_byte_encryption_key_generated_with_openssl_rand_hex_32"

# Environnement (development, production)
VITE_ENV_NODE="development"
